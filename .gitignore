# Evaluation layout (see evaluations/_common/paths.py):
#   pool/     checkpoints (tracked; training logs stay local)
#   results/  intermediates, regenerable from the pool; only the small
#             records that document choices are tracked
#   reports/  tables, figures, HTML: generated by reproduce.sh, not tracked
evaluations/pool/**
!evaluations/pool/**/
!evaluations/pool/**/*.zip
evaluations/results/**
!evaluations/results/*/
!evaluations/results/cross_scenario/selection.json
!evaluations/results/cross_scenario/SWEEP.json
evaluations/reports/

# Documentation lives outside the repo, except the README
*.md
!README.md

# Agent tooling and build metadata (local only)
.claude/
.agents/
*.egg-info/
